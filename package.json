{
  "name": "waxum-channel",
  "version": "0.1.0",
  "description": "Claude Code channel: bridges WhatsApp (via the waxum REST gateway) into a running Claude Code session",
  "license": "MIT",
  "type": "module",
  "bin": {
    "waxum-channel": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
